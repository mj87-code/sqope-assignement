ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Owner/superuser password — used by the indexer (writes) and to bootstrap the DB.
DB_PASSWORD=change-me
# Password for the SELECT-only api_reader role the API connects as. Set a
# different value from DB_PASSWORD.
API_DB_PASSWORD=change-me-too
# Optional — a HuggingFace token silences the unauthenticated rate-limit warning
# and speeds up Docling/embedding model downloads during indexing.
HF_TOKEN=
